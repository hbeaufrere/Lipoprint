function GetName(ListName: string; i: integer): string;{Returns the the ith line from a text file that has beenread into a one line image named 'ListName'.}var   loc, ch: integer;   name: string;begin  SelectWindow(ListName);  loc := -1;  for i := 2 to i do     repeat       loc := loc + 1;       ch := GetPixel(loc, 0)     until ch < 32; {return or linefeed}  name := '';  repeat     loc := loc + 1;     ch := GetPixel(loc, 0);     if ch >= 32 then       name := concat(name, chr(ch));  until ch < 32;  GetName := name;end;macro 'OD value assign v.90701';var count,loop, width,height, scanlength, space, v,  xtube, ytube, u: integerppv, min, max:real folder, path, path1, ListName, ImageName,  mess, mess1, scanner, wt : stringbegin{ytube:=488;}                 {starting point for tube scan, y-axis}xtube:=317;                 {starting point for tube scan, x-axis}space:= 26.5;                  {spacing between tubes, middle to middle}scanlength:= 28;     {length of profile plot cut}{following are the user defined Rf values -the program drops the lines at the respective values}ruser1[401]:= 12.335; {calibration curve parameters for TIFFEN 20-step tablet} {step 1}ruser1[402]:= 53.306; {step2}ruser1[403]:= 90.838;ruser1[404]:= 120.501;ruser1[405]:= 142.592;ruser1[406]:= 161.492;	ruser1[407]:= 177.234;ruser1[408]:= 190.668;ruser1[409]:= 201.170;ruser1[410]:= 209.748; {step 10}ruser1[411]:= 216.231;ruser1[412]:= 222.301;ruser1[413]:= 226.028;ruser1[414]:= 230.019;ruser1[415]:= 232.877;ruser1[416]:= 234.751;ruser1[417]:= 237.400;ruser1[418]:= 239.569;ruser1[419]:= 241.412;ruser1[420]:= 242.540; {step 20}putmessage ('Make sure that the color target was scanned in position 1.1 (facing the holder handle) of the 4x5 batch film holder (scan area 8x10)!');mess:= getstring ('calibration step 1 (orig scanner) or step 2?', '1');if mess ='1' then beginopen ('Macintosh HD:Desktop Folder:');{('Macintosh HD:Desktop Folder:');