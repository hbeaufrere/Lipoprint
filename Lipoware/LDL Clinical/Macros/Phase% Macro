{ Calculate phase % when in density slice mode         22 Sep 94  }macro 'Phase% [P]';var   width,height,lower,upper,sum: real;  i: integer;begin  RequiresVersion(1.44);  GetPicSize(width,height);  SetUser1Label('Phase%');  Measure;  GetThresholds(lower,upper);  sum:= 0;  for i:= lower to upper do    sum:= sum + histogram[i];  rUser1[rCount]:= sum/width/height*100;  UpdateResults;end;