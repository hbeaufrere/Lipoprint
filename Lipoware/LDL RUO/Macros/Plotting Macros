in + 270);   Writeln('0');   MoveTo(margin + 92, margin + 270);   Writeln('100');   MoveTo(margin + 192, margin + 270);   Writeln('200');   MoveTo(margin + 248, margin + 270);   Writeln('255');   MoveTo(margin + 70, margin + 290);   Writeln('Z-value on slice', xslice:1);   MoveTo(margin - 65, margin + 100);   Writeln('Z-value');   MoveTo(margin - 65, margin + 115);   Writeln('on slice', yslice:1);   RestoreState;end;